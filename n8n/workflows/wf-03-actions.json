    {
      "id": "6bf6a14f-103c-55ef-828f-157e32762312",
      "name": "재시작 판단",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        440
      ],
      "parameters": {
        "jsCode": "// 지금 상태를 보고 재시작해도 되는지 정한다. 5분 안에 다시 시작한 적이 있으면 거절 (버튼 연타, 재시작 반복 방지).\nconst req = $('요청 정리').item.json;\nconst res = $json;\nif (res.statusCode !== 200) return [{ json: { ...req, ok: false, result: 'refused', note: `Deployment 조회 실패 (${res.statusCode}).` } }];\nconst last = res.body.spec?.template?.metadata?.annotations?.['kubectl.kubernetes.io/restartedAt'];\nconst ago = last ? (Date.now() - Date.parse(last)) / 60000 : Infinity;\nif (ago < 5) return [{ json: { ...req, ok: false, result: 'refused', note: `\\`${req.deploy}\\` 는 ${Math.round(ago)}분 전에 재시작했습니다. 5분 안에는 다시 하지 않습니다.` } }];\nconst now = new Date().toISOString();\nreturn [{ json: { ...req, ok: true, replicas: res.body.spec?.replicas ?? null,\n  patch: { spec: { template: { metadata: { annotations: { 'kubectl.kubernetes.io/restartedAt': now, 'kube-chatops/restarted-by': `slack:${req.user_id}` } } } } } } }];"
      }
    },
