    {
      "id": "359853fc-e8eb-56ad-8ac9-a52168d5d17a",
      "name": "확인",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "jsCode": "const req = $('요청 정리').item.json;\nconst res = $json;\nconst ok = res.statusCode === 200 && res.body.metadata?.labels?.['security.kube-chatops/quarantine'] === 'true';\nconst note = res.statusCode === 404 ? `\\`${req.pod}\\` 는 이미 없습니다.`\n  : res.statusCode !== 200 ? `파드 조회 실패 (${res.statusCode}).`\n  : ok ? '' : `\\`${req.pod}\\` 는 격리된 파드가 아니라 지우지 않았습니다.`;\nreturn [{ json: { ...req, ok, note, result: ok ? null : 'refused' } }];"
      }
    },
