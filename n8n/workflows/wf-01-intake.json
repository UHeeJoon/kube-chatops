        "jsCode": "// 두 갈래(권한/형식 답장, /route 답장)에서 온 항목을 같은 모양으로\nconst it = $json;\nconst result = it.role === 'none' ? 'denied' : (it.intent ? `reply:${it.intent}` : 'reply');\nreturn [{ json: { ...it, result } }];"
