    {
      "id": "09bbe324-a16a-525e-8396-8dc253777016",
      "name": "요청 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const DEPLOYS = ['demo-app'];\nconst ev = $json;\nconst id = ev.action?.id ?? '';\nconst [namespace, name] = String(ev.action?.value ?? '').split('/');\nlet op = id === 'sec_delete_pod' ? 'delete_pod' : ['act_restart', 'act_rollback', 'act_scale'].includes(id) ? id.slice(4) : 'unknown', note = '';\nif (ev.role !== 'operator') { op = 'deny'; note = '조치 버튼은 operator 만 누를 수 있습니다.'; }\nelse if (op === 'unknown') note = `모르는 조치입니다 (${id}).`;\nelse if (op === 'delete_pod' && (namespace !== 'demo' || !/^[a-z0-9.-]{1,253}$/.test(name ?? ''))) { op = 'deny'; note = '대상이 올바르지 않습니다.'; }\nelse if (op !== 'delete_pod' && (namespace !== 'demo' || !DEPLOYS.includes(name))) { op = 'deny'; note = `조치할 수 없는 대상입니다 (허용: ${DEPLOYS.map(d => 'demo/' + d).join(', ')}).`; }\nreturn [{ json: { ...ev, op, namespace, pod: op === 'delete_pod' ? name : null, deploy: op !== 'delete_pod' && op !== 'deny' && op !== 'unknown' ? name : null, note } }];"
      }
    },
