      ],
      "parameters": {
        "method": "POST",
        "url": "http://agent.aiops.svc:8080/route",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
