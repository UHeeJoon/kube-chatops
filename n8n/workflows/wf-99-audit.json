  "active": true,
  "nodes": [
    {
      "id": "c95c94b2-ff33-5115-a9cd-db495e14877a",
      "name": "다른 흐름에서 호출",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        100
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "944cb904-f42e-5072-ab14-93d7fd4101b9",
      "name": "흐름 실패",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "3758929c-dcc2-5296-b03e-1f5a010f8c11",
      "name": "오류 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// 다른 워크플로가 실패하면 여기로 온다 (워크플로 설정의 Error Workflow)\nconst e = $json;\nreturn [{ json: { flow: e.workflow?.name ?? 'unknown', result: 'error', execution_id: e.execution?.id ?? null,\n  failed_node: e.execution?.lastNodeExecuted ?? null, error: (e.execution?.error?.message ?? '').slice(0, 500) } }];"
      }
    },
    {
      "id": "8149d021-9777-5fd2-be62-ef61388ac78e",
      "name": "감사 로그 보내기",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "http://chat-gateway.aiops.svc:8080/audit",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ...$json, at: new Date().toISOString() }) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "kcgatewayapi0001",
          "name": "chat-gateway API"
        }
      }
    },
    {
      "id": "6dc4836b-5dd2-50df-bdf6-4f6c95d66176",
      "name": "오류 알림 글",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        400
      ],
      "parameters": {
        "jsCode": "// 워크플로가 중간에 실패하면 사용자는 아무 답도 받지 못한다 (\"조사하고 있습니다\" 가 그대로 남거나 버튼을 눌러도 무응답).\n// 어느 스레드였는지는 여기서 알 수 없으므로 알림 채널에 한 줄 올린다. 오류 글은 줄이고 Slack 서식 문자를 뺀다.\nconst e = $json;\nconst msg = String(e.error ?? '').replace(/[<>`*_~|]/g, ' ').slice(0, 200);\nreturn [{ json: { text: `:x: 자동화 흐름 *${String(e.flow).replace(/[<>`*_~|]/g, ' ')}* 가 \\`${String(e.failed_node ?? '?').replace(/[<>`*_~|]/g, ' ')}\\` 단계에서 실패했습니다. 진행 중이던 조사나 버튼 처리가 끝나지 않았을 수 있습니다.\\n_${msg} · 실행 ${e.execution_id ?? '?'}_` } }];"
      }
    },
    {
      "id": "bb3f82c1-01aa-5d02-83a7-72ba994f6cc9",
      "name": "오류 알림",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "http://chat-gateway.aiops.svc:8080/slack/post",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "kcgatewayapi0001",
          "name": "chat-gateway API"
        }
      }
    }
  ],
