    {
      "id": "bc792482-2184-5401-a68c-b7cf975fc444",
      "name": "커밋 결과",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        640
      ],
      "parameters": {
        "jsCode": "const req = $('파일 고치기').item.json;\nconst ok = [200, 201].includes($json.statusCode);\nconst sha = ok ? $json.body.commit.sha : '';\nreturn [{ json: { ...req, result: ok ? (req.op === 'scale' ? 'scale_committed' : 'rollback_committed') : 'commit_failed',\n  done: ok ? `\\`${req.op}\\` ${req.namespace}/${req.deploy} (${req.what})` : null,\n  note: ok ? `:rocket: <@${req.user_id}> 승인으로 \\`${req.namespace}/${req.deploy}\\` ${req.what} 커밋을 올렸습니다 (<${$json.body.commit.html_url}|${sha.slice(0, 7)}>). 배포 검사 → release → Argo CD 반영까지 3~5분 걸립니다.`\n    : `커밋 실패 (${$json.statusCode}): ${JSON.stringify($json.body?.message ?? '').slice(0, 200)}` } }];"
      }
    },
    {
      "id": "7524e497-0a23-507b-8b0c-e201682d1334",
      "name": "답장 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        300
      ],
      "parameters": {
        "jsCode": "// 스레드 답장 + 실행한 조치의 버튼을 카드에서 빼고 \"누가 언제 승인\" 한 줄로 바꾼다 (두 번 누르지 않게).\nconst it = $json;\nlet card = null;\nif (it.done && it.message_ts && (it.message?.blocks ?? []).length) {\n  const kst = new Date().toLocaleString('ko-KR', { timeZone: 'Asia/Seoul', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false });\n  const out = [];\n  for (const b of it.message.blocks) {\n    if (b.type !== 'actions') { out.push(b); continue; }\n    const rest = (b.elements ?? []).filter(e => !(e.action_id === it.action?.id && String(e.value) === String(it.action?.value)));\n    if (rest.length !== (b.elements ?? []).length) out.push({ type: 'context', elements: [{ type: 'mrkdwn', text: `:white_check_mark: ${it.done} · <@${it.user_id}> 승인 · ${kst}` }] });\n    if (rest.length) out.push({ ...b, elements: rest });\n  }\n  card = { channel: it.channel_id, ts: it.message_ts, text: it.message?.text || '조치 승인', blocks: out };\n}\nreturn [{ json: { channel: it.channel_id, thread_ts: it.thread_id, text: it.note || '처리했습니다.', card,\n  audit: { flow: 'wf-03-actions', result: it.result ?? it.op, op: it.op, target: it.pod ? `${it.namespace}/${it.pod}` : it.deploy ? `${it.namespace}/deployment/${it.deploy}` : null,\n    detail: it.what ?? null, user_id: it.user_id, role: it.role, channel_id: it.channel_id, thread_id: it.thread_id } } }];"
      }
    },
