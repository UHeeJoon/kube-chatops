# 요청 흐름: Cloudflare → cloudflared → Cilium Gateway(public-gateway) → 이 프록시(WAF) → demo-app
#           load-gen → 이 프록시 → demo-app (평소 트래픽으로 오탐을 본다)
{
	admin off
	auto_https off
	order coraza_waf first
	order rate_limit before coraza_waf
	servers {
		# 실제 클라이언트 IP: 클러스터 안(사설 대역)에서 온 요청의 CF-Connecting-IP 만 믿는다.
		# 바깥에서 오는 길은 Cloudflare 터널 하나뿐이고 Cloudflare 가 이 헤더를 덮어쓴다.
		# 이 파드에 들어올 수 있는 것은 게이트웨이와 load-gen 뿐이다 (CiliumNetworkPolicy).
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		trusted_proxies_strict
	}
	metrics
	log {
		output stdout
		format json
		# Coraza 가 Caddy 로거로 남기는 줄(규칙마다 한 줄, 평소 요청에도 "key not found in collection" 경고)은 버린다.
		# 11-27 실측 평소 트래픽만으로 5분 2,200줄. 차단 기록은 아래 감사 로그(요청 하나 = JSON 한 줄)로 충분하다.
		exclude http.handlers.waf
	}
}

:8080 {
	# 접근 로그는 남기지 않는다 (평소 초당 5건 → 하루 43만 줄). 차단한 요청만 감사 로그(실제 IP, 요청, 걸린 규칙)로 남는다
	# 운영용 경로는 게이트웨이 쪽에 내놓지 않는다 (장애 주입은 n8n·스크립트가 demo-app 에 직접 한다)
	@ops path /chaos/* /metrics /healthz* /readyz
	respond @ops 404

	# 요청 수 제한: 실제 IP(client_ip, Cloudflare 헤더 반영) 하나당 10초에 100건. 넘으면 429 (Retry-After).
	# 클러스터 안(load-gen 등 사설 IP)은 빼고 바깥 요청만 센다. 파드 2개가 각자 세서 실제 한도는 최대 2배다.
	# 걸린 IP 는 로그 한 줄(logger http.handlers.rate_limit, key=IP)로 남는다 → mcp-loki waf_blocks
	rate_limit {
		zone per_ip {
			match {
				not client_ip private_ranges
			}
			key {http.vars.client_ip}
			window 10s
			events 100
		}
		log_key
	}

	coraza_waf {
		load_owasp_crs
		directives `
			Include @coraza.conf-recommended
			Include @crs-setup.conf.example
			Include @owasp_crs/*.conf
			SecRuleEngine On
			SecResponseBodyAccess Off
			# 감사 로그 = 막은(403) 요청 하나당 JSON 한 줄 → Loki → mcp-loki waf_blocks 도구가 읽는다
			SecAuditEngine RelevantOnly
			SecAuditLogRelevantStatus "^403$"
			SecAuditLogParts ABHZ
			SecAuditLogFormat JSON
			SecAuditLogType Serial
			SecAuditLog /dev/stdout
		`
	}
	reverse_proxy {$UPSTREAM:demo-app.demo.svc:8080} {
		# Cilium 은 연결 단위로 백엔드 파드를 고른다. 연결을 재사용하면 요청이 한 파드에 몰려
		# (11-27 실측 4.6 대 0.6 rps) 파드별 지표(메모리 누수 등)가 왜곡된다. 요청마다 새 연결.
		transport http {
			keepalive off
		}
	}
}

# Prometheus 수집용 (요청 수·응답 코드). 게이트웨이에는 내놓지 않는다
:9180 {
	metrics
}
