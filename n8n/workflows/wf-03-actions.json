      ],
      "parameters": {
        "jsCode": "const req = $('재시작 판단').item.json;\nconst ok = $json.statusCode === 200;\nreturn [{ json: { ...req, result: ok ? 'restarted' : 'restart_failed', done: ok ? `\\`restart\\` ${req.namespace}/${req.deploy}` : null,\n  note: ok ? `:arrows_counterclockwise: <@${req.user_id}> 승인으로 \\`${req.namespace}/${req.deploy}\\` 를 재시작합니다 (파드 ${req.replicas ?? '?'}개를 하나씩 교체, 1분쯤 걸림).`\n    : `재시작 실패 (${$json.statusCode}): ${JSON.stringify($json.body?.message ?? '').slice(0, 200)}` } }];"
      }
